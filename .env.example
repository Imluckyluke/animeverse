# نمونهٔ متغیرهای محیطی انیمه‌ورس — مقادیر واقعی را در .env.local بگذارید.
# هرگز کلیدها را با پیشوند NEXT_PUBLIC_ نسازید؛ آن‌ها داخل جاوااسکریپت مرورگر منتشر می‌شوند.

# آدرس عمومی سایت (برای canonical، sitemap، robots و لینک‌های مطلق)
NEXT_PUBLIC_SITE_URL=https://example.com
AV_PUBLIC_URL=https://example.com

# کلید مدیریت — فقط سمت سرور. بدون آن، APIهای /api/admin/* پاسخ ۵۰۳ می‌دهند.
ADMIN_KEY=

# مسیرها و تنظیمات ورکر تلگرام (فقط روی سروری که ورکر اجرا می‌شود لازم است)
AV_ROOT=/path/to/animeverse
AV_PYTHON=/usr/bin/python3
AV_ARCHIVE_INVITE=
AV_LINK_DELAY=60
AV_LINK_JITTER=10
AV_LINK_COOLDOWN=300
AV_LINK_COOLDOWN_EVERY=10
AV_MAX_FLOOD_WAIT=1800
AV_FLOOD_COOLDOWN=3600
AV_WATCH_INTERVAL=300

# متغیرهای فقط‌سمت‌سرور سرویس‌های خصوصی. بدون پیشوند NEXT_PUBLIC_ در مرورگر منتشر نمی‌شوند.
# تنظیمات بک‌اند در service.env و تنظیمات پل سمت‌سرور سایت در محیط امن میزبان وب نگهداری می‌شوند؛
# این فایل فقط نمونهٔ خالی و امن برای توسعه است.
AV_ADMIN_DISCOVERY_URL=
AV_ADMIN_SERVICE_TOKEN=
AV_DOWNLOAD_CACHE_TOKEN=
AV_DOWNLOAD_CACHE_ORIGIN=
AV_DOWNLOAD_CACHE_DISCOVERY_URL=
AV_DOWNLOAD_CACHE_CA_PEM=
AV_DATA_DIR=

# ورکر تلگرام: مقادیر نمونهٔ عمومی تلگرام دسکتاپ در کد به‌عنوان fallback هستند.
# برای بازنویسی، شناسه/هش خود را اینجا بگذارید؛ توکن‌ها را خالی نگه دارید.
# نشست تلگرام را در فایل بدون‌ردیابی tools/tg/session.txt نگه دارید و TG_SESSION را اینجا ننویسید.
TG_API_ID=
TG_API_HASH=
TG_NOTIFY_BOT_TOKEN=
