# نمونهٔ متغیرهای محیطی انیمه‌ورس — مقادیر واقعی را در .env.local بگذارید.
# هرگز کلیدها را با پیشوند NEXT_PUBLIC_ نسازید؛ آن‌ها داخل جاوااسکریپت مرورگر منتشر می‌شوند.

# آدرس عمومی سایت (برای canonical، sitemap، robots و لینک‌های مطلق)
NEXT_PUBLIC_SITE_URL=https://example.com
AV_PUBLIC_URL=https://example.com

# کلید مدیریت — فقط سمت سرور. بدون آن، APIهای /api/admin/* پاسخ ۵۰۳ می‌دهند.
ADMIN_KEY=یک-رشته-تصادفی-بلند

# مسیرها و تنظیمات ورکر تلگرام (فقط روی سروری که ورکر اجرا می‌شود لازم است)
AV_ROOT=/path/to/animeverse
AV_PYTHON=/usr/bin/python3
AV_ARCHIVE_INVITE=
AV_LINK_DELAY=60
AV_LINK_JITTER=10
AV_LINK_COOLDOWN=300
AV_LINK_COOLDOWN_EVERY=10
AV_MAX_FLOOD_WAIT=1800
AV_FLOOD_COOLDOWN=3600
AV_WATCH_INTERVAL=300
