[Unit]
Description=AnimeVerse secure administration API
After=network-online.target
Wants=network-online.target

[Service]
User=bot-host
Group=bot-host
WorkingDirectory=/var/lib/bot-host/animeverse
EnvironmentFile=/var/lib/bot-host/.local/share/animeverse-admin/service.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/var/lib/bot-host/.cache/animeverse-download-cache
ExecStart=/usr/bin/python3 -u tools/tg/admin_service.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bot-host/animeverse/data /var/lib/bot-host/animeverse/public/covers/admin
MemoryMax=768M
CPUQuota=100%
TasksMax=64
LimitCORE=0

[Install]
WantedBy=multi-user.target
