[Unit]
Description=AnimeVerse signed admin control tunnel
After=network-online.target animeverse-admin.service
Wants=network-online.target animeverse-admin.service

[Service]
User=bot-host
Group=bot-host
WorkingDirectory=/var/lib/bot-host/animeverse
EnvironmentFile=/var/lib/bot-host/.local/share/animeverse-admin/tunnel.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/var/lib/bot-host/.cache/animeverse-download-cache
ExecStart=/usr/bin/python3 -u tools/tg/admin_tunnel.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bot-host/.local/share/animeverse-admin
MemoryMax=256M
TasksMax=32
LimitCORE=0

[Install]
WantedBy=multi-user.target
